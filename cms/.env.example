# ─────────────────────────────────────────────────────────────────────────────
# Kailo CMS — environment
#
#   cp .env.example .env
#
# then fill in the secrets. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──
HOST=0.0.0.0
PORT=1337
# Absolute public origin of this API. Required in production when Strapi sits
# behind a proxy or CDN — it is how upload URLs are built.
# PUBLIC_URL=https://cms.kailo.com

# ── Secrets ──
# Four comma-separated keys used to sign session cookies.
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=replace_me
ADMIN_JWT_SECRET=replace_me
TRANSFER_TOKEN_SALT=replace_me
JWT_SECRET=replace_me
# 32 hex characters (16 bytes).
ENCRYPTION_KEY=replace_me

# ── PostgreSQL ──
# This project is Postgres-only; DATABASE_CLIENT must stay `postgres`.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=kailo
DATABASE_USERNAME=kailo
DATABASE_PASSWORD=change_me
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Hosted Postgres (Render / Railway / Supabase / Neon / Heroku) hands you a
# single connection string. When DATABASE_URL is set it wins and the discrete
# vars above are ignored. Those providers also need DATABASE_SSL=true; the
# default DATABASE_SSL_REJECT_UNAUTHORIZED=false accepts their certificates.
# DATABASE_URL=postgresql://user:password@host:5432/kailo
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── CORS ──
# Primary allowed origin. The common localhost dev ports (8080 — what
# frontend uses — plus 3000 and 5173) are always allowed on top of this.
FRONTEND_URL=http://localhost:8080
# Extra origins, comma-separated. Add preview deployments here.
# FRONTEND_URLS=https://kailo.vercel.app,https://www.kailo.com

# ── Seed ──
# Seed the database on first boot. `npm run seed` always works regardless.
SEED_ON_BOOT=true
# Where the seed reads the original images from, at seed time only. Defaults to
# ../frontend/src/assets relative to this folder.
# KAILO_ASSETS_DIR=/absolute/path/to/frontend/src/assets
# How long to wait for each remote (Unsplash) image download.
# SEED_FETCH_TIMEOUT_MS=20000

# ── Environment ──
# Strapi reads NODE_ENV to pick its environment. `npm start` without it runs in
# `development`, which is not what you want on a server. Set it in the host's env
# (Render/Railway/Fly/systemd/PM2), not here — this file is for local dev.
# NODE_ENV=production

# ── Accounts ──
# Public self-registration on POST /api/auth/local/register. Off unless this is
# `true`; reconciled on every boot by src/seed/permissions.ts, because the real
# switch is a database row and not a config file. The storefront has no auth
# phase, so leaving it off means the endpoint cannot be used to mint accounts.
# Turn it on when the auth phase lands.
# USERS_ALLOW_REGISTER=true

# ── Public form spam control ──
# Per-IP fixed window on POST /api/contact-submissions and
# POST /api/newsletter-subscriptions.
PUBLIC_FORM_WINDOW_MS=60000
PUBLIC_FORM_MAX_SUBMISSIONS=5

# Separate, much looser window for cart writes (PUT /api/carts/token/...). One
# shopper nudging quantities behind a 1.5s debounce can legitimately produce
# dozens of these a minute, so they cannot share the form budget.
CART_WRITE_WINDOW_MS=60000
CART_WRITE_MAX=60

# ── Uploads ──
# UPLOAD_SIZE_LIMIT=26214400
#
# Where uploaded files live: local | aws-s3 | cloudinary. Defaults to local, which
# writes to public/uploads — fine for development, but those files are lost on every
# redeploy of an ephemeral or serverless host, taking every image on the site with
# them. Pick a remote provider before the first real deploy and install its package:
#
#   aws-s3      npm install @strapi/provider-upload-aws-s3
#   cloudinary  npm install @strapi/provider-upload-cloudinary
#
# Naming a provider without its package installed fails at boot with the install
# command you need. See README "Switching the upload provider".
# UPLOAD_PROVIDER=local

# ── Media hosts (CSP) ──
# Once uploads live off this origin, the serving host must be allowed in the
# img-src / media-src directives or the admin media library shows broken
# thumbnails. CDN_URL doubles as the S3 provider's baseUrl; CDN_HOSTS is a
# comma-separated list for anything extra. A full URL or a bare host both work.
# CDN_URL=https://cdn.kailo.com
# CDN_HOSTS=res.cloudinary.com

# ── S3 upload provider (see README "Switching the upload provider") ──
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=
# AWS_BUCKET=

# ── Cloudinary upload provider ──
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=
