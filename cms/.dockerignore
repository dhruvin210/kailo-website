# Keep the build context small, and keep secrets and host-built artefacts out of
# the image. Everything here is either regenerated by the build or must not be
# baked in.

node_modules
dist
build
.cache
.tmp
.strapi
.strapi-updater.json
types/generated

# Never bake secrets into a layer. The container gets its environment from
# docker-compose.yml at run time.
.env
.env.*
!.env.example

# Seeded media. The image ships an empty uploads folder; the real one is a named
# volume, and the seed refills it on first boot.
public/uploads/*
!public/uploads/.gitkeep

.git
.gitignore
*.log
exports
Dockerfile
.dockerignore
