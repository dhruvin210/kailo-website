{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "The Kailo catalogue. Mirrors frontend/src/lib/products.ts."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0,
      "description": "Whole rupees (INR). No decimals — the frontend formats with formatINR()."
    },
    "rating": {
      "type": "decimal",
      "min": 0,
      "max": 5
    },
    "reviews": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "remoteImageUrl": {
      "type": "string",
      "description": "Fallback source URL, kept when the seed could not download the remote original."
    },
    "remoteGalleryUrls": {
      "type": "json",
      "description": "Fallback source URLs for `gallery`, in order."
    },
    "description": {
      "type": "text",
      "required": true
    },
    "specs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.spec"
    },
    "badge": {
      "type": "enumeration",
      "enum": ["NEW", "SALE"]
    },
    "stock": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 0
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
