{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "The homepage, section by section. Mirrors frontend/src/routes/index.tsx."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },

    "heroEyebrow": {
      "type": "string"
    },
    "heroHeadingLine1": {
      "type": "string"
    },
    "heroHeadingLine2": {
      "type": "string",
      "description": "Rendered italic in the primary teal."
    },
    "heroSubtext": {
      "type": "text"
    },
    "heroPrimaryCtaLabel": {
      "type": "string"
    },
    "heroPrimaryCtaHref": {
      "type": "string"
    },
    "heroSecondaryCtaLabel": {
      "type": "string"
    },
    "heroSecondaryCtaHref": {
      "type": "string"
    },
    "heroSlides": {
      "type": "component",
      "repeatable": true,
      "component": "home.hero-slide"
    },
    "heroStats": {
      "type": "component",
      "repeatable": true,
      "component": "home.hero-stat"
    },

    "storyEyebrow": {
      "type": "string"
    },
    "storyHeading": {
      "type": "string"
    },
    "storyBody": {
      "type": "text"
    },
    "storyBodySecondary": {
      "type": "text"
    },
    "storyChips": {
      "type": "json",
      "description": "Array of strings, e.g. [\"Full-grain leather\", \"Hand-stitched\"]."
    },
    "storyStatValue": {
      "type": "string"
    },
    "storyStatLabel": {
      "type": "string"
    },
    "storyImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "storyInsetImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "The small overlapping workshop frame."
    },
    "storyCtaLabel": {
      "type": "string"
    },
    "storyCtaHref": {
      "type": "string"
    },

    "categoriesEyebrow": {
      "type": "string"
    },
    "categoriesHeading": {
      "type": "string"
    },
    "categoryTiles": {
      "type": "component",
      "repeatable": true,
      "component": "home.category-tile"
    },

    "galleryEyebrow": {
      "type": "string"
    },
    "galleryHeading": {
      "type": "string"
    },
    "galleryDescription": {
      "type": "text"
    },
    "homeGallery": {
      "type": "component",
      "repeatable": true,
      "component": "home.gallery-tile"
    },

    "whyEyebrow": {
      "type": "string"
    },
    "whyHeading": {
      "type": "string"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature"
    },

    "bestSellersEyebrow": {
      "type": "string"
    },
    "bestSellersHeading": {
      "type": "string"
    },
    "bestSellersDescription": {
      "type": "text"
    },
    "bestSellers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product"
    },

    "testimonialsEyebrow": {
      "type": "string"
    },
    "testimonialsHeading": {
      "type": "string"
    },
    "testimonialsDescription": {
      "type": "text"
    },
    "testimonials": {
      "type": "component",
      "repeatable": true,
      "component": "home.testimonial"
    },

    "newsletter": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    }
  }
}
