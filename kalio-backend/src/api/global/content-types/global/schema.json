{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Site-wide settings: brand, navbar and footer. Mirrors Navbar.tsx + Footer.tsx."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "default": "Kailo"
    },
    "tagline": {
      "type": "string",
      "default": "Crafted with finesse, made to move your soul."
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "logoLight": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Light variant used on the teal footer."
    },
    "navLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-link"
    },
    "footerQuickLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-link"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "contactEmail": {
      "type": "string"
    },
    "contactPhone": {
      "type": "string"
    },
    "contactAddress": {
      "type": "string"
    },
    "contactHours": {
      "type": "string"
    },
    "copyright": {
      "type": "string"
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
