{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About Page",
    "description": "The /about page. Mirrors kalio-frontend/src/routes/about.tsx."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },

    "heroEyebrow": {
      "type": "string"
    },
    "heroHeadingLine1": {
      "type": "string"
    },
    "heroHeadingLine2": {
      "type": "string",
      "description": "Rendered italic in the primary teal."
    },
    "heroSubtext": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },

    "storyEyebrow": {
      "type": "string"
    },
    "storyHeading": {
      "type": "string"
    },
    "storyLead": {
      "type": "text",
      "description": "The opening paragraph. Set full width under the heading, in lead style with a drop cap."
    },
    "storyParagraphs": {
      "type": "json",
      "description": "Array of strings. The paragraphs that follow the lead, set in the column beside the image."
    },
    "storyPullQuote": {
      "type": "text",
      "description": "A line lifted out of the story to break the column. Must be an exact quote from the copy above."
    },
    "storyChips": {
      "type": "json"
    },
    "storyImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "storyStatValue": {
      "type": "string"
    },
    "storyStatLabel": {
      "type": "string"
    },

    "materialsEyebrow": {
      "type": "string"
    },
    "materialsHeading": {
      "type": "string"
    },
    "materialsDescription": {
      "type": "text"
    },
    "materials": {
      "type": "component",
      "repeatable": true,
      "component": "about.material"
    },

    "craftEyebrow": {
      "type": "string"
    },
    "craftHeading": {
      "type": "string"
    },
    "craftDescription": {
      "type": "text"
    },
    "craftImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "craftDetails": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature"
    },

    "valuesEyebrow": {
      "type": "string"
    },
    "valuesHeading": {
      "type": "string"
    },
    "values": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature"
    },

    "audienceEyebrow": {
      "type": "string"
    },
    "audienceHeading": {
      "type": "string"
    },
    "audienceDescription": {
      "type": "text"
    },
    "audiences": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature"
    },

    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    }
  }
}
