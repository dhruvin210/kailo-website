{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact Submission",
    "description": "Captured by the /contact form. Public role has `create` only."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "minLength": 2
    },
    "email": {
      "type": "email",
      "required": true
    },
    "subject": {
      "type": "string",
      "description": "One of General Inquiry / Order Support / Wholesale / Press (the frontend select)."
    },
    "message": {
      "type": "text",
      "required": true,
      "minLength": 20
    },
    "handled": {
      "type": "boolean",
      "default": false
    }
  }
}
