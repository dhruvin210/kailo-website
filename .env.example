# ─────────────────────────────────────────────────────────────────────────────
# Kailo — docker compose environment
#
#   cp .env.example .env
#
# Read by docker-compose.yml in this folder, and by nothing else. It is the
# single source of the database credentials: the `db` container is created with
# them and the `cms` container connects with them, so the two cannot drift.
#
# The other two env files are not replaced by this one — each package still
# owns its own:
#
#   cms/.env        Strapi's secrets, CORS, seeding, upload provider
#   frontend/.env   the storefront's build-time VITE_ vars
#
# Never commit the .env itself. See .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──
# These create the database on first `up`. Changing them afterwards does not
# rename anything — the volume already holds a database built with the old
# values, and you would get an authentication failure. Start over with
# `docker compose down -v`.
DATABASE_NAME=kailo
DATABASE_USERNAME=kailo
DATABASE_PASSWORD=change_me

# Host port for Postgres. Move it if a native install already holds 5432; this
# maps the host side only, and the CMS container always talks to db:5432.
DATABASE_PORT=5432

# ── CMS ──
# Host port for the Strapi admin panel and API. 1337 is Strapi's convention and
# the committed default, but Razer's RzSDKServer squats on it on some Windows
# machines. If `up` reports the port is already used, change it here — and make
# VITE_STRAPI_URL in frontend/.env match.
CMS_PORT=1337
