# Copy to `.env` and adjust. Only VITE_-prefixed vars reach the app: vite.config.ts
# forwards them into `import.meta.env` for both the client and the SSR bundle.

# ── Strapi CMS ──
#
# Base origin of the API, without a trailing slash and without `/api`.
#
#   local     http://localhost:1337   (or 1338 — match kalio-backend/.env PORT;
#                                      Razer's RzSDKServer squats on 1337)
#   preview   https://kailo-cms-staging.example.com
#   prod      https://cms.kailo.com
#
# LEAVING THIS UNSET IS A SUPPORTED MODE. With no value the app serves the
# committed snapshot in src/lib/cms-snapshot/ and the images in public/uploads/
# instead of calling a CMS — which is how the storefront is deployed while the
# backend is not yet hosted. Setting the variable switches back to live reads
# with no code change; see the note at the top of src/lib/cms-snapshot/index.ts.
# Regenerate the snapshot with `node scripts/snapshot-cms.mjs` against a running
# CMS whenever the seeded content changes.
#
# Note there is deliberately no localhost default. `import.meta.env` is inlined
# at build time, so a default meant a deploy that forgot this variable shipped
# localhost into production and 500'd on every route.
#
# Uploaded media is served from this origin too, so it must be reachable from the
# browser, not just from the SSR server.
#
# The CMS must allow this app's origin in CORS — set FRONTEND_URL (and optionally
# the comma-separated FRONTEND_URLS) in kalio-backend/.env. localhost:8080 is
# allowed by default.
VITE_STRAPI_URL=http://localhost:1337

# ── WhatsApp ──
#
# The number behind the "WhatsApp" contact option on /contact. International
# format, digits only — no `+`, spaces or brackets (`wa.me` accepts nothing else).
#
# Optional. Left unset, the published phone number from the CMS contact page is
# used instead, since it is the same business line. If neither resolves to at
# least 8 digits the WhatsApp option is dropped from the page entirely rather
# than rendered as a dead link — see `whatsappUrl` in src/lib/strapi.ts.
#
# Set this only when WhatsApp lives on a different number from the published one.
# VITE_WHATSAPP_NUMBER=919876543210

# ── Nothing to configure for carts ──
#
# The cart is mirrored to the CMS so a `?cart=<token>` link can rehydrate it on
# another device. It reuses VITE_STRAPI_URL above and needs no vars of its own:
#
#   • the cart stays in localStorage and keeps working if the CMS is unreachable
#     — the mirror swallows its failures;
#   • a `cartToken` is generated in the browser on first visit and kept in
#     localStorage (`kailo-cart-token`), alongside the cart itself (`kailo-cart`).
