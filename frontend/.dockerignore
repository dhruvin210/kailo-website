# Keep the build context small, and keep secrets and host-built artefacts out of
# the image. Everything here is either regenerated by the build or must not be
# baked in.

node_modules
dist
dist-ssr
.output
.nitro
.vinxi
.tanstack

# Never bake secrets into a layer, and — more to the point here — never let a
# workstation .env reach the build. VITE_ vars are inlined by `vite build`, so a
# local `VITE_STRAPI_URL=http://localhost:1338` would be compiled straight into
# the image and every route would 500 inside the container. The build takes that
# value from the VITE_STRAPI_URL build arg instead. See Dockerfile.
.env
.env.*
!.env.example

# public/uploads is deliberately NOT ignored, unlike the CMS image's copy of the
# same path. There it is a named volume the seed refills; here it is the ~63 MB
# of media that snapshot mode serves, and without it the built site renders every
# image as a 404.

.git
.gitignore
*.log
Dockerfile
.dockerignore
