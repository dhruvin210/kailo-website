_indigo_f3c1d6c624.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-07-30T20:32:42.494Z","updatedAt":"2026-07-30T20:32:42.494Z","publishedAt":"2026-07-30T20:32:42.494Z"}}]},"meta":{}}
